# agentree 环境变量示例。复制为 .env 后按需修改；.env 已被 .gitignore 忽略，切勿提交。
# 所有配置均可通过环境变量或 .env 提供；未配置时 LLM 客户端会报错提示。

# ---- LLM（三选一，优先级 AGENTREE_* > DEEPSEEK_* > OPENAI_*）----
# 1) 自建 / 本地 OpenAI 兼容网关：
AGENTREE_API_KEY=sk-your-local-gateway-key
AGENTREE_BASE_URL=http://127.0.0.1:3065/v1
AGENTREE_MODEL=deepseek-v4-flash
# 2) DeepSeek 官方：
# DEEPSEEK_API_KEY=sk-xxxx
# 3) OpenAI 官方：
# OPENAI_API_KEY=sk-xxxx

# ---- 演示模式：跳过第三方登录，直接下发本地 token（公开演示 / 截图用）----
# 生产环境保持 off；开启后登录页出现「演示模式」入口。
AGENTREE_DEMO_AUTH=off

# ---- 登录：第三方统一登录系统（账号即统一登录账号，非本地账号）----
# 仅当你接入内部统一登录时配置；演示模式下无需理会。
AGENTREE_LOGIN_SYSTEM_URL=http://192.168.6.3:18010
AGENTREE_LOGIN_SYSTEM_URL_FALLBACK=
AGENTREE_LOGIN_APP_NAME=agentree
# 共享密钥（本地验签用），默认与登录系统一致，一般无需修改：
# AGENTREE_LOGIN_JWT_SECRET=my_super_secret_key_qw1230
# AGENTREE_LOGIN_AES_KEY=login_system_123
# AGENTREE_LOGIN_AES_IV=login_system_iv_

# ---- 联网搜索（SearXNG 聚合，免 key）----
# 故障转移链（逗号分隔，默认内置 5 个自建实例）；留空则用内置默认。
# AGENTREE_SEARXNG_URLS=http://192.168.6.3:18088,
# 本机 DNS 污染导致公网站点被 SSRF 防护误拦时可关闭（风险自担）：
# AGENTREE_SSRF_GUARD=off
